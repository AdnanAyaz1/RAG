    "passlib": "^1.7.4",
    "redis": "^5.0.0",
    "alembic": "^1.13.0",
    "python-dotenv": "^1.0.0"
  },
  "devDependencies": {
    "ruff": "^0.4.0",
    "pytest": "^8.2.0",
